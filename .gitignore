# Build artifacts
build/
target/
core/target
ios/build/
ios/build-device/
ios/build-sim/
ios/build-test/
platform/apple/.build/

# wasm-pack output (per-crate pkg/ regenerated by publish-npm.sh)
core/crates/*-wasm/pkg/

# Heavy data caches (per inputx-pinyin/inputx-wubi exclude rules; gitignored
# at workspace level so cp / git archive don't accidentally track them)
core/crates/inputx-pinyin/data/corpus/cache/
core/crates/inputx-pinyin/data/unihan/
core/crates/inputx-pinyin/data/jieba/
core/crates/inputx-wubi/data/corpus/cache/

# Editor swap / temp
*.rs.tmp

# Xcode user state
**/xcuserdata/
*.xcuserstate

# Xcodegen-generated project (canonical source is ios/project.yml)
ios/Inputx.xcodeproj/

# cbindgen-generated C header (regenerated by core/crates/inputx-core/build.rs)
core/include/inputx_core.h

# Debug symbols
*.dSYM/

# Maestro test outputs
.maestro/
**/.maestro/

# Claude workspace — internal planning/working docs, never published.
# Use `.claude/*` (not `.claude/`) so the directory itself isn't excluded;
# git refuses to re-include children of an excluded parent directory, so
# the `!` allowlist for skills/ below would otherwise be a no-op.
.claude/*
**/.claude/*
# Exception: skills are repo-shared (versioned with the code that
# invokes them). Personal/transient .claude content stays ignored.
!.claude/skills/
!.claude/skills/**
!**/.claude/skills/
!**/.claude/skills/**

# macOS / editor cruft
.DS_Store
*.swp
*~

# Local data backups from scoring polish scripts (kept on disk for
# manual recovery, not part of repo)
*.pretrad-backup
*.preoverlap-backup
*.prejianma2-backup
*.prelong-backup

# Scoring pipeline intermediate data — regenerable from corpora; `make clean`
# wipes these. Only data/supplemental + data/polish_reports stay tracked.
tools/scoring/data/extracted/
tools/scoring/data/normalized/
tools/scoring/data/layers/
tools/scoring/data/merged/
tools/scoring/data/annotations/
tools/scoring/data/baseline/
tools/scoring/data/.markers/
