# Build artifacts
build/
target/
core/target
ios/build/
ios/build-device/
ios/build-sim/
ios/build-test/
platform/apple/.build/

# wasm-pack output (per-crate pkg/ regenerated by publish-npm.sh)
core/crates/*-wasm/pkg/

# Heavy data caches (per inputx-pinyin/inputx-wubi exclude rules; gitignored
# at workspace level so cp / git archive don't accidentally track them)
core/crates/inputx-pinyin/data/corpus/cache/
core/crates/inputx-pinyin/data/unihan/
core/crates/inputx-pinyin/data/jieba/
core/crates/inputx-wubi/data/corpus/cache/
# mozc dictionary_oss download (BSD-3, ~59 MB) — regenerable via the curl loop
# in build_mozc_jukugo.py's docstring; the derived jp_jukugo_mozc_v1.tsv IS
# committed (and jukugo.rs is generated from it).
tools/nihongo/.mozc_cache/

# Editor swap / temp
*.rs.tmp

# Xcode user state
**/xcuserdata/
*.xcuserstate

# Xcodegen-generated project (canonical source is ios/project.yml)
ios/Inputx.xcodeproj/

# cbindgen-generated C header (regenerated by core/crates/inputx-core/build.rs)
core/include/inputx_core.h

# Debug symbols
*.dSYM/

# Maestro test outputs
.maestro/
**/.maestro/

# Claude workspace — internal planning/working docs, never published.
# All `.claude/` contents are ignored, no exceptions (user directive
# 2026-06-03: "我们不考虑别人用"). Previously had a `.claude/skills/`
# whitelist for shared skills; retired — even skills live untracked
# now, persisted only on the developer's local machine.
.claude/*
**/.claude/*

# macOS / editor cruft
.DS_Store
*.swp
*~

# Local data backups from scoring polish scripts (kept on disk for
# manual recovery, not part of repo)
*.pretrad-backup
*.preoverlap-backup
*.prejianma2-backup
*.prelong-backup

# Scoring pipeline intermediate data — regenerable from corpora; `make clean`
# wipes these. Only data/supplemental + data/polish_reports stay tracked.
tools/scoring/data/extracted/
tools/scoring/data/normalized/
tools/scoring/data/layers/
tools/scoring/data/merged/
tools/scoring/data/annotations/
tools/scoring/data/baseline/
tools/scoring/data/filtered/
tools/scoring/data/.markers/
# discover_new_words.py pass1 cache (char+bigram freqs) — large, regenerable
tools/scoring/data/supplemental/.discover_cache_*.pkl
# CP3d name-corpus download (wainshine/Chinese-Names-Corpus, 12 MB) — large,
# regenerable via 03b_pollution/build_name_chars.py; derived char tables
# (03b_pollution/name_chars.tsv, surnames.tsv) ARE committed.
tools/scoring/data/cache/
# (duplicate .claude/ block retired 2026-06-03 — see the single rule at
# the top of this file)

# generated by mac/generate_icon.py
mac/Resources/inputx_app_icon.iconset/

# corpus harvest output (regenerated from upstream dumps)
tools/corpus-harvest/output/
!tools/corpus-harvest/output/.gitkeep
tools/corpus-harvest/.cache/
tools/dict-pipeline/output/
data/private-dict/vNEXT/

# Python bytecode caches
__pycache__/
*.pyc

# Evaluation corpus raw downloads (regenerable from upstream dumps)
# Directories kept via .gitkeep; large dumps / extracted text excluded.
tools/eval/corpus/raw/wiki/*
!tools/eval/corpus/raw/wiki/.gitkeep
tools/eval/corpus/raw/lccc/*
!tools/eval/corpus/raw/lccc/.gitkeep
tools/eval/corpus/raw/pd/*
!tools/eval/corpus/raw/pd/.gitkeep
tools/eval/corpus/raw/cc100/*
!tools/eval/corpus/raw/cc100/.gitkeep

# Phase 2 LM training intermediates (regenerable via clean.py).
tools/scoring/09_bigram_lm/data/
tools/eval/corpus/processed/
tools/eval/results/*.json
!tools/eval/results/.gitkeep
# Dated daily runs accumulate and are regenerable, so they stay ignored —
# but the canonical baseline is the cross-session diff anchor (CP-0.5) and
# must be tracked so `--diff baseline.json` works in a fresh checkout.
!tools/eval/results/baseline.json

# MIU set is deterministic-generated from corpus + script + seed.
# Regenerate via `python3 tools/eval/build_miu_set.py`.
# Gold-1000 set (CP-0.4) IS committed since it has human annotations.
tools/eval/miu_set.tsv
tools/eval/miu_set_paired.tsv
tools/eval/silver_full.tsv

# Eval Python venv (per PEP 668 — brew Python is externally managed,
# can't system-pip-install). Pin deps via tools/eval/requirements.txt.
tools/eval/.venv/
