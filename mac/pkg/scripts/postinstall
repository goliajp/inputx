#!/bin/bash
# Inputx .pkg postinstall — make the IME show up in System Settings → Keyboard
# → Text Input → + immediately, without requiring the user to log out.
set -euo pipefail

APP="/Library/Input Methods/Inputx.app"
LSREG="/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"

CONSOLE_USER=$(/usr/bin/stat -f%Su /dev/console)
CONSOLE_UID=$(/usr/bin/id -u "$CONSOLE_USER")
USER_TMP=$(/bin/launchctl asuser "$CONSOLE_UID" /usr/bin/getconf DARWIN_USER_CACHE_DIR)

"$LSREG" -f "$APP" || true

# The IntlDataCache files under the user's `C/` temp dir hold the input-source
# enumeration result and are sticky across TextInputMenuAgent restarts. Delete
# them so the next TIS query rebuilds against the freshly-installed bundle.
/bin/rm -f \
    "$USER_TMP/com.apple.IntlDataCache.le" \
    "$USER_TMP/com.apple.IntlDataCache.le.kbdx"

# Register Inputx with the TIS database + enable each declared mode in the
# console user's session (so it lands in their keyboard menu).
/bin/launchctl asuser "$CONSOLE_UID" "$APP/Contents/MacOS/Inputx" install || true

/usr/bin/killall TextInputMenuAgent 2>/dev/null || true

exit 0
