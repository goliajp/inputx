<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle identity -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Inputx</string>
    <!-- The `.inputmethod.` infix is the canonical reverse-DNS namespace
         that the macOS input-source picker uses to recognize third-party
         IME bundles. Drop the infix and the picker won't enumerate. -->
    <key>CFBundleIdentifier</key>
    <string>jp.golia.inputmethod.wubi</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Inputx</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleSignature</key>
    <string>INPX</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Golia K.K. / Inputx contributors. MIT License.</string>

    <!-- LaunchServices behavior -->
    <key>LSUIElement</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <!-- Read CFBundleName / CFBundleDisplayName / per-mode display labels
         from `Resources/<locale>.lproj/InfoPlist.strings`. The mode-id =>
         label mapping in each .strings file is what the picker shows under
         each language tab. -->
    <key>LSHasLocalizedDisplayName</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSRequiresAquaSystemAppearance</key>
    <string>No</string>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>UIDesignRequiresCompatibility</key>
    <false/>

    <!-- App icon. CFBundleIconFile (legacy) + CFBundleIconName (modern)
         both point to the same .icns; build.sh generates it from the menu
         TIFF via `sips -s format icns`. -->
    <key>CFBundleIconFile</key>
    <string>inputx_app_icon</string>
    <key>CFBundleIconName</key>
    <string>inputx_app_icon</string>

    <!-- IMK server wiring. InputMethodConnectionName is the Mach service
         name the IMK server registers; the matching entitlement is in
         Inputx.entitlements. -->
    <key>InputMethodConnectionName</key>
    <string>jp.golia.inputmethod.wubi_Connection</string>
    <key>InputMethodServerControllerClass</key>
    <string>InputxController</string>
    <key>InputMethodServerDelegateClass</key>
    <string>InputxController</string>

    <!-- Top-level TIS umbrella source: bundle-level TIS entry separate
         from the per-mode entries inside ComponentInputModeDict. -->
    <key>TISInputSourceID</key>
    <string>jp.golia.inputmethod.wubi</string>
    <key>TISIconIsTemplate</key>
    <true/>
    <key>TISParticipatesInTouchBar</key>
    <false/>

    <!-- IMK character repertoire + menu icon (TIFF, used by the menu-bar
         input-source indicator; distinct from the bundle .icns above). -->
    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Latn</string>
        <string>Hans</string>
    </array>
    <key>tsInputMethodIconFileKey</key>
    <string>inputx_menu_icon.tiff</string>

    <key>ComponentInputModeDict</key>
    <dict>
        <key>tsInputModeListKey</key>
        <dict>
            <key>jp.golia.inputmethod.wubi.zh</key>
            <dict>
                <key>TISInputSourceID</key>
                <string>jp.golia.inputmethod.wubi.zh</string>
                <!-- TISIntendedLanguage routes the mode to a specific
                     language tab in the System Settings picker. -->
                <key>TISIntendedLanguage</key>
                <string>zh-Hans</string>
                <key>TISIconLabels</key>
                <dict>
                    <key>Primary</key>
                    <string>五笔</string>
                </dict>
                <key>tsInputModeScriptKey</key>
                <string>smUnicode</string>
                <key>tsInputModeCharacterRepertoireKey</key>
                <array>
                    <string>Hans</string>
                    <string>Hani</string>
                    <string>Han</string>
                </array>
                <key>tsInputModeIsVisibleKey</key>
                <true/>
                <key>tsInputModeMenuIconFileKey</key>
                <string>inputx_menu_icon.tiff</string>
                <key>tsInputModePaletteIconFileKey</key>
                <string>inputx_menu_icon.tiff</string>
                <key>tsInputModePrimaryInScriptKey</key>
                <true/>
            </dict>
        </dict>
        <key>tsVisibleInputModeOrderedArrayKey</key>
        <array>
            <string>jp.golia.inputmethod.wubi.zh</string>
        </array>
    </dict>
</dict>
</plist>
