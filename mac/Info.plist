<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Inputx</string>
    <key>CFBundleIdentifier</key>
    <string>jp.golia.inputx</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Inputx</string>
    <key>CFBundleDisplayName</key>
    <string>Inputx 输入法</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Xcode-style build metadata. Manually-built (`swiftc` direct, not
         via Xcode) bundles otherwise miss these and macOS 26's input-source
         picker treats them as suspicious / non-enumerable. Values mirror
         what Xcode would emit for an arm64 macosx target. -->
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>DTPlatformName</key>
    <string>macosx</string>
    <key>DTSDKName</key>
    <string>macosx13.0</string>
    <key>DTPlatformVersion</key>
    <string>13.0</string>
    <key>DTCompiler</key>
    <string>com.apple.compilers.llvm.clang.1_0</string>
    <!-- LSBackgroundOnly is *required* for IME enumeration in macOS
         13+ — the input-source picker silently filters out bundles
         that set LSUIElement instead. NSStatusItem still works under
         LSBackgroundOnly (the menu-bar item is its only UI; the
         "Inputx" app has no Dock icon and no window either way). -->
    <key>LSBackgroundOnly</key>
    <true/>
    <!-- Custom NSApplication subclass. Class name MUST be the bare ObjC
         runtime name (`InputxApplication`), NOT the Swift module-prefixed
         form (`Inputx.InputxApplication`) — `@objc(InputxApplication)` in
         Sources/InputxApplication.swift strips the module prefix, and
         Cocoa's principal-class lookup uses the ObjC runtime name.
         Plain "NSApplication" leaves a race where IMK probes NSApp.delegate
         before the top-level Swift code has attached one. -->
    <key>NSPrincipalClass</key>
    <string>InputxApplication</string>
    <key>InputMethodConnectionName</key>
    <string>jp.golia.inputx_Connection</string>
    <key>InputMethodServerControllerClass</key>
    <string>InputxController</string>
    <key>InputMethodServerDelegateClass</key>
    <string>InputxController</string>
    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Latn</string>
        <string>Hans</string>
    </array>
    <!-- macOS 26's input-source picker filters out IMEs that don't ship
         a top-level menu icon file. Empty string in tsInputModeMenuIconFileKey
         counts as "missing"; the bundle is silently dropped from TIS
         enumeration. Real .tiff in Contents/Resources/ — see
         Resources/inputx_menu_icon.tiff (built into the .app by build.sh). -->
    <key>tsInputMethodIconFileKey</key>
    <string>inputx_menu_icon.tiff</string>
    <key>ComponentInputModeDict</key>
    <dict>
        <key>tsInputModeListKey</key>
        <dict>
            <key>jp.golia.inputx.zh</key>
            <dict>
                <key>tsInputModeAlternateMenuIconFileKey</key>
                <string>inputx_menu_icon.tiff</string>
                <key>tsInputModeDefaultStateKey</key>
                <true/>
                <key>tsInputModeIsVisibleKey</key>
                <true/>
                <key>tsInputModeKeyEquivalentKey</key>
                <string></string>
                <key>tsInputModeKeyEquivalentModifiersKey</key>
                <integer>0</integer>
                <key>tsInputModeMenuIconFileKey</key>
                <string>inputx_menu_icon.tiff</string>
                <key>tsInputModePaletteIconFileKey</key>
                <string>inputx_menu_icon.tiff</string>
                <key>tsInputModePrimaryInScriptKey</key>
                <true/>
                <key>tsInputModeScriptKey</key>
                <string>smSimpChinese</string>
            </dict>
        </dict>
        <key>tsVisibleInputModeOrderedArrayKey</key>
        <array>
            <string>jp.golia.inputx.zh</string>
        </array>
    </dict>
</dict>
</plist>
